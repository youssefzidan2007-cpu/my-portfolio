# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Password you type at "Admin sign in" to add or delete projects (8+ characters)
ADMIN_PASSWORD=my_secure_password_2026

# Long random text used to sign the admin cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Largest Excel/CSV upload allowed, in megabytes
MAX_UPLOAD_MB=10

# Where the database and uploaded files live. Put this on a persistent disk when you deploy.
DATA_DIR=./data

# Set to "production" when hosting online (enables secure cookies and HTTPS-only headers)
# NODE_ENV=production